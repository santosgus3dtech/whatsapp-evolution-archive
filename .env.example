# Copy to .env and generate each secret privately. Never commit .env.
ARCHIVE_USERNAME=admin
ARCHIVE_PASSWORD=
WEBHOOK_SECRET=
EVOLUTION_API_KEY=
POSTGRES_USER=evolution
POSTGRES_DB=evolution
POSTGRES_PASSWORD=
# URL-encode POSTGRES_PASSWORD inside this URI; see docs/CONFIGURATION.md.
DATABASE_CONNECTION_URI=
EVOLUTION_INSTANCE=archive-demo
ARCHIVE_PORT=8097
ARCHIVE_BIND_ADDRESS=127.0.0.1
# Leave empty for localhost. Set the exact HTTPS origin when using a proxy.
ARCHIVE_PUBLIC_ORIGIN=
ARCHIVE_PUBLIC_PATH=/
ARCHIVE_IMAGE_TAG=public
# Docker's internal addresses. Override both when running without Docker.
EVOLUTION_API_URL=http://evolution:8080
ARCHIVE_INTERNAL_URL=http://archive:8000
# Local development only; Docker defines these paths inside its container.
ARCHIVE_DATA_DIR=./data
ARCHIVE_STATIC_DIR=apps/panel/dist
